#include <stdio.h>

int main() {
    double num1, num2;

    printf("Enter first number: ");
    scanf("%lf", &num1);

    printf("Enter second number: ");
    scanf("%lf", &num2);

    if (num1 > num2) {
        printf("The greatest number is %.2lf\n", num1);
        printf("The smallest number is %.2lf\n", num2);
    } 
    else if (num2 > num1) {
        printf("The greatest number is %.2lf\n", num2);
        printf("The smallest number is %.2lf\n", num1);
    } 
    else {
        printf("Both numbers are equal.\n");
    }

    return 0;
}
