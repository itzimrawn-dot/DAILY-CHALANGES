#include <stdio.h>
#include <math.h>  // For the constant M_PI

int main() {
    int choice;
    float length, width, side, base, height, radius;

    printf("Select the shape to calculate area:\n");
    printf("1. Rectangle\n");
    printf("2. Square\n");
    printf("3. Triangle\n");
    printf("4. Circle\n");
    printf("Enter your choice (1-4): ");
    scanf("%d", &choice);

    if (choice == 1) {
        printf("Enter length and width of the rectangle: ");
        scanf("%f %f", &length, &width);
        printf("Area of Rectangle: %.2f\n", length * width);
    } 
    else if (choice == 2) {
        printf("Enter the side of the square: ");
        scanf("%f", &side);
        printf("Area of Square: %.2f\n", side * side);
    } 
    else if (choice == 3) {
        printf("Enter base and height of the triangle: ");
        scanf("%f %f", &base, &height);
        printf("Area of Triangle: %.2f\n", 0.5 * base * height);
    } 
    else if (choice == 4) {
        printf("Enter the radius of the circle: ");
        scanf("%f", &radius);
        printf("Area of Circle: %.2f\n", M_PI * radius * radius);
    } 
    else {
        printf("Invalid choice! Please select a number between 1 and 4.\n");
    }

    return 0;
}
